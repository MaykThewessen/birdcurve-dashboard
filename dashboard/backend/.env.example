# BirdCurve Dashboard backend configuration.
# Copy to .env (git-ignored) and adjust paths. All settings use the
# BIRDCURVE_ prefix and map to fields in app/config.py.

# On-disk DuckDB with ts_15min / ts_hourly / ts_4hourly / ts_daily / provenance.
BIRDCURVE_DUCKDB_PATH=/path/to/birdcurve.duckdb

# Directory containing Production_Ensemble_* and Forecast_* run directories.
BIRDCURVE_MODEL_RESULTS_DIR=/path/to/model_results

# Glob for the engineered-features file (.feather or .parquet) used by
# /api/ml/correlation-matrix.
BIRDCURVE_HISTORICAL_FEATURES_PATH=/path/to/Historical_data_features_engineered_*.parquet

# Optional sidecar CSVs (globs). When absent, the EUR/USD and Coal API2
# series and KPIs degrade to empty arrays.
BIRDCURVE_EUR_USD_PATH=/path/to/EUR_USD_daily_*.csv
BIRDCURVE_COAL_API2_PATH=/path/to/commodity_coal_API2_daily_*.csv

# CORS origins for the frontend dev server (JSON list).
BIRDCURVE_CORS_ORIGINS=["http://localhost:5173"]
